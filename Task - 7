// 16. Employee Dashboard  
let employees = [
    { name: "Siva", salary: 25000 },
    { name: "Ganesh", salary: 40000 },
    { name: "Babu", salary: 55000 }
];
let totalSalary = employees.reduce((total, emp) => {
    return total + emp.salary;
}, 0);
let averageSalary = totalSalary / employees.length;
let highestSalary = employees.reduce((max, emp) => {
    return emp.salary > max ? emp.salary : max;
}, 0);
console.log("Total Salary:", totalSalary); // Total Salary: 120000
console.log("Average Salary:", averageSalary); // Average Salary: 40000
console.log("Highest Salary:", highestSalary); // Highest Salary: 55000

