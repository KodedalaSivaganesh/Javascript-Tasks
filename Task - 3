// Employee Management System
let employee = {
    name: "Sivaganesh",
    role: "Fronend Developer",
    salary: 50000,
    attendance: "Present"
};

let choice = 5;

switch (choice) {
    case 1:
        console.log("Add Employee");
        console.log("Employee Added Successfully");
        break;

    case 2:
        console.log("Employee Details");
        console.log("Name: " + employee.name);
        console.log("Role: " + employee.role);
        console.log("Salary: " + employee.salary);
        break;

    case 3:
        console.log("Calculate Bonus");

        let bonus = employee.salary * 10 / 100;
        console.log("Bonus: " + bonus);
        break;

    case 4:
        console.log("Check Attendance");

        if (employee.attendance === "Present") {
            console.log("Employee is Present");
        } else {
            console.log("Employee is Absent");
        }
        break;

    case 5:
        console.log("Print Salary");   // Print Salary
        console.log("Salary: " + employee.salary); // Salary: 50000
        break;

    case 6:
        console.log("Exit");
        break;

    default:
        console.log("Invalid Choice");
}

