// Employee Management System
function Employee_Details(Name, Id, Department, Basic_Salary, Bonus, Experience, Skills) {

    let Employee = {
        Name: Name,
        Id: Id,
        Department: Department,
        Basic_Salary: Basic_Salary,
        Bonus: Bonus,
        Experience: Experience,
        Skills: Skills
    };

    console.log("Name : " + Employee.Name);
    console.log("Id : " + Employee.Id);
    console.log("Department : " + Employee.Department);
    console.log("Basic Salary : " + Employee.Basic_Salary);
    console.log("Bonus : " + Employee.Bonus);

    Gross_Salary = Employee.Basic_Salary + Employee.Bonus;
    console.log("Gross Salary : " + Gross_Salary);

    if (Employee.Experience >= 5) {
        console.log("Experienced Employee");
    } else {
        console.log("Fresher Employee");
    }

    console.log("Skills : " + Employee.Skills);
}

let Skills = ["HTML", "CSS", "Javascript", "Python", "SQL"];

Employee_Details("Sivaganesh", "EMP1234", "ECE", 30000, 5000, 3, Skills);

